# local postgres
DB_CONTAINER_NAME=tut-postgres-db
DB_PORT=8101
AM_PORT_DEFAULT=5432
DB_NAME=postgres
DB_USER_NAME=postgres
DB_PASSWORD=postgres

# adminder(AM) is the phpmyadmin for postgress
AM_PORT=8102
AM_PORT_DEFAULT=8080
AM_CONTAINER_NAME=tut-postgres-am

CB_PORT=8103
CB_PORT_DEFAULT=8978
CB_CONTAINER_NAME=tut-postgres-cb

PG_PORT=8104
PG_PORT_DEFAULT=80
PG_HTTP_PORT=8105
PG_HTTP_PORT_DEFAULT=443
PG_CONTAINER_NAME=tut-postgres-pg
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin